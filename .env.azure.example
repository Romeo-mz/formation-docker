# Configuration du volet azure_deploy
# Copiez ce fichier vers .env.azure puis adaptez les valeurs.

# Option A — fallback GitHub Container Registry personnel
REGISTRY=ghcr.io
IMAGE_NAMESPACE=CHANGE_ME/formation-vote

# Option B — Azure Container Registry
# REGISTRY=acrformationvote.azurecr.io
# IMAGE_NAMESPACE=formation-vote
# ACR_NAME=acrformationvote

IMAGE_TAG=local
REGISTRY_USERNAME=CHANGE_ME
REGISTRY_PASSWORD=CHANGE_ME

AZURE_RESOURCE_GROUP=rg-formation-vote
AZURE_LOCATION=westeurope
CONTAINERAPPS_ENVIRONMENT=cae-formation-vote
VOTE_APP_NAME=ca-vote
RESULT_APP_NAME=ca-result
WORKER_APP_NAME=ca-worker

REDIS_CONNECTION_STRING=redis://CHANGE_ME:6379
POSTGRES_CONNECTION_STRING=Server=CHANGE_ME;Username=CHANGE_ME;Password=CHANGE_ME;Database=postgres;Ssl Mode=Require;
DATABASE_URL=postgres://CHANGE_ME:CHANGE_ME@CHANGE_ME/postgres?sslmode=require
