# Configuration pour la branche github_deploy
# Copiez ce fichier vers .env.ghcr puis adaptez les valeurs.
# Ne commitez jamais .env.ghcr (il est dans .gitignore).

# GitHub Container Registry
REGISTRY=ghcr.io
IMAGE_NAMESPACE=VOTRE_LOGIN_GITHUB/formation-vote

# Identifiants : utilisez un Personal Access Token (classic) avec scope "write:packages"
# Créez-en un sur : https://github.com/settings/tokens
REGISTRY_USERNAME=VOTRE_LOGIN_GITHUB
REGISTRY_PASSWORD=VOTRE_GITHUB_TOKEN

IMAGE_TAG=local
